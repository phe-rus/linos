# Common minimum Linos kernel boot and filesystem requirements.
CONFIG_MODULES=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EXT4_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_VIRTIO=y

# Preserve a readable recovery console while preparing DRM/KMS graphics.
# FRAMEBUFFER_CONSOLE requires the framebuffer core; DRM's fbdev
# compatibility makes it available for a virtio GPU guest.
CONFIG_FB=y
CONFIG_DRM_FBDEV_EMULATION=y
