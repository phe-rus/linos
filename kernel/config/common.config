# Common minimum Linos kernel boot and filesystem requirements.
CONFIG_MODULES=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EXT4_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_VIRTIO=y

# Preserve a readable recovery console while preparing DRM/KMS graphics.
# FRAMEBUFFER_CONSOLE requires the framebuffer core; DRM's fbdev
# compatibility makes it available for a virtio GPU guest.
CONFIG_FB=y
CONFIG_DRM_FBDEV_EMULATION=y

# Linos kernel security policy: constrain unprivileged programs by default.
# These are real upstream kernel features, not cosmetic release branding.
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y

# Linos-owned boot-state handshake and observable resource pressure.
CONFIG_LINOS_BOOT_STATE=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_PSI=y

# Cross-device responsiveness. The same Linos kernel can select a supported
# preemption model at boot without rebuilding for Server and Desktop.
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PREEMPT_DYNAMIC=y

# Measurable application and service isolation, not arbitrary SIGSTOP policy.
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_FREEZER=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Retain kernel console diagnostics across crashes where a supported pstore
# storage backend exists. This does not itself implement rollback.
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# Kernel primitives for future authenticated image integrity and disk
# protection. Enabling them does NOT imply verified boot or encryption.
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_DM_CRYPT=y
CONFIG_OVERLAY_FS=y
