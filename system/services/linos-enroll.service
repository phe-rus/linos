[Unit]
Description=Enroll first local Linos administrator
Documentation=https://github.com/phe-rus/linos
Requires=linos-first-boot.service
After=linos-first-boot.service local-fs.target
Before=multi-user.target getty@tty1.service serial-getty@ttyS0.service serial-getty@ttyAMA0.service
ConditionPathExists=/var/lib/linos/device-id
ConditionPathExists=!/var/lib/linos/owner

[Service]
Type=oneshot
ExecStart=/usr/lib/linos/linos-enroll
Environment=TERM=xterm-256color
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/console
TTYReset=yes
TTYVHangup=yes
TimeoutStartSec=0
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
